# Copy this file to `.env` and fill in the values you want.

# ---- deployment safety switch ----
# For public URLs (Deno Deploy, etc.) set this to `true`. All live-mode paths
# are disabled regardless of other env — safe to share the URL.
# For local LIVE testing, leave it blank or set to `false`.
SIM_SANDBOX_ONLY=

# ---- live-mode credentials (ignored when SIM_SANDBOX_ONLY=true) ----

BACKEND_URL=http://localhost:8000
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=
FINERACT_WEBHOOK_SECRET=
SIM_ENTERPRISE_ID=

# ---- sim ----

SIM_PORT=8010
