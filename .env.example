# Copy this file to `.env` and fill in the values you want. Everything is
# optional — missing values trigger OFFLINE mode (in-memory sandbox phones).

# Backend URL to post signed Fineract-shaped webhooks at.
BACKEND_URL=http://localhost:8000

# Supabase project (service role).
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=

# Same HMAC secret the backend uses to verify Fineract webhooks.
FINERACT_WEBHOOK_SECRET=

# Which enterprise to pull real devices from.
SIM_ENTERPRISE_ID=

# HTTP port the sim listens on.
SIM_PORT=8010
